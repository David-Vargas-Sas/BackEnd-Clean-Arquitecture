{
  "name": "backend-ventas",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de productos, vendedores y ventas",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "start": "node --env-file=.env src/server.js",
    "dev": "node --env-file=.env --watch src/server.js",
    "db:setup": "node --env-file=.env scripts/setup-db.js",
    "db:migrate": "node --env-file=.env scripts/migrate-db.js",
    "auth:create-user": "node --env-file=.env scripts/create-user.js",
    "db:verify": "node --env-file=.env scripts/verify-postgres.js",
    "db:concurrency": "node --env-file=.env scripts/verify-concurrency.js",
    "db:schema": "node scripts/build-schema.js",
    "test": "node --test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.16.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "supertest": "^7.1.0"
  }
}
